{
	"name": "@deanrih/ts-lib-codec-string",
	"version": "1.1.0",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "MIT",
	"homepage": "https://deanrih.id/projects/self/ts-lib-codec-string",
	"description": "A small library for string encoding and decoding",
	"readme": "./README.md",
	"author": {
		"name": "deanrih",
		"url": "https://github.com/deanrih"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/deanrih/ts-lib-codec-string"
	},
	"bugs": {
		"url": "https://github.com/deanrih/ts-lib-codec-string/issues"
	},
	"keywords": [],
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./base32": {
			"import": {
				"types": "./dist/internal/base32.internal.d.ts",
				"default": "./dist/internal/base32.internal.mjs"
			},
			"require": {
				"types": "./dist/internal/base32.internal.d.cts",
				"default": "./dist/internal/base32.internal.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun run --watch ./example/index.example.ts",
		"case:dev": "bun run --watch ./example/case.example.ts",
		"test": "bun test",
		"build": "bun ./build.ts",
		"release": "bun run test && bun run build && bun publish"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/bun": "latest",
		"tsup": "latest",
		"typescript": "latest"
	},
	"peerDependencies": {}
}